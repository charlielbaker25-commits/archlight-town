---
// The site footer: name, contact details and the jump links again.
interface Props { business: string; area?: string; address?: string; phoneDisplay?: string; phoneTel?: string; email?: string; links?: { href: string; label: string }[] }
const { business, area, address, phoneDisplay, phoneTel, email, links = [] } = Astro.props;
---
<footer class="site-footer">
  <div class="wrap footer-grid">
    <div>
      <p class="footer-name">{business}</p>
      {area && <p class="footer-muted">{area}</p>}
    </div>
    <div class="footer-contact">
      {address && <address>{address}</address>}
      {phoneDisplay && <a href={phoneTel} class="whitespace-nowrap">{phoneDisplay}</a>}
      {email && <a href={`mailto:${email}`}>{email}</a>}
    </div>
    {links.length > 0 && (
      <nav aria-label="Footer">
        <ul role="list">{links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
      </nav>
    )}
  </div>
</footer>

<style>
  .site-footer { background: var(--color-ink, #1c1917); color: var(--color-paper, #fff); padding: 3.5rem 0 2rem; }
  .footer-grid { display: grid; gap: 2rem; }
  @media (min-width: 860px) { .footer-grid { grid-template-columns: 1.2fr 1fr 1fr; } }
  .footer-name { font-family: var(--font-display, inherit); font-size: 1.5rem; font-weight: 700; margin: 0; }
  .footer-muted { margin: 0.25rem 0 0; opacity: 0.85; }
  .footer-contact { display: grid; gap: 0.5rem; align-content: start; }
  address { font-style: normal; }
  a { color: inherit; display: inline-flex; align-items: center; min-height: 44px; text-underline-offset: 4px; }
  ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.1rem; }
</style>
